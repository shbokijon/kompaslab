{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/dashboard",
      "destination": "/dashboard.html"
    },
    {
      "source": "/lesson",
      "destination": "/lesson.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/login",
      "destination": "/login.html"
    },
    {
      "source": "/register",
      "destination": "/register.html"
    },
    {
      "source": "/payment",
      "destination": "/payment.html"
    },
    {
      "source": "/reset",
      "destination": "/reset-password.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/master-lab-m0-darslar",
      "destination": "/master-lab-m0",
      "permanent": false
    },
    {
      "source": "/master-lab-m0-darslar.html",
      "destination": "/master-lab-m0",
      "permanent": false
    },
    {
      "source": "/master-lab-modul",
      "has": [
        {
          "type": "query",
          "key": "m",
          "value": "(?<m>[1-8])"
        }
      ],
      "destination": "/master-lab-m:m",
      "permanent": false
    },
    {
      "source": "/master-lab-modul",
      "destination": "/master-lab-dastur",
      "permanent": false
    },
    {
      "source": "/master-lab-modul.html",
      "destination": "/master-lab-dastur",
      "permanent": false
    },
    {
      "source": "/usa-lab-m9",
      "destination": "/usa-lab-dastur",
      "permanent": true
    },
    {
      "source": "/usa-lab-m9.html",
      "destination": "/usa-lab-dastur",
      "permanent": true
    },
    {
      "source": "/usa-lab-m10",
      "destination": "/usa-lab-dastur",
      "permanent": true
    },
    {
      "source": "/usa-lab-m10.html",
      "destination": "/usa-lab-dastur",
      "permanent": true
    },
    {
      "source": "/usa-lab-m11",
      "destination": "/usa-lab-dastur",
      "permanent": true
    },
    {
      "source": "/usa-lab-m11.html",
      "destination": "/usa-lab-dastur",
      "permanent": true
    }
  ]
}
