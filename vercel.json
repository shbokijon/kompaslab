{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/dashboard",
      "destination": "/dashboard.html"
    },
    {
      "source": "/lesson",
      "destination": "/lesson.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/login",
      "destination": "/login.html"
    },
    {
      "source": "/register",
      "destination": "/register.html"
    },
    {
      "source": "/payment",
      "destination": "/payment.html"
    },
    {
      "source": "/reset",
      "destination": "/reset-password.html"
    },
    {
      "source": "/donat",
      "destination": "/qollab-quvvatlash.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://api.open-meteo.com https://archive-api.open-meteo.com https://cdn.jsdelivr.net; frame-src https://player.vimeo.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://my.click.uz; object-src 'none'"
        }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/master-lab-m0-darslar",
      "destination": "/master-lab-m0",
      "permanent": false
    },
    {
      "source": "/master-lab-m0-darslar.html",
      "destination": "/master-lab-m0",
      "permanent": false
    },
    {
      "source": "/master-lab-modul",
      "has": [
        {
          "type": "query",
          "key": "m",
          "value": "(?<m>[1-8])"
        }
      ],
      "destination": "/master-lab-m:m",
      "permanent": false
    },
    {
      "source": "/master-lab-modul",
      "destination": "/master-lab-dastur",
      "permanent": false
    },
    {
      "source": "/master-lab-modul.html",
      "destination": "/master-lab-dastur",
      "permanent": false
    },
    {
      "source": "/usa-lab-m9",
      "destination": "/usa-lab-dastur",
      "permanent": true
    },
    {
      "source": "/usa-lab-m9.html",
      "destination": "/usa-lab-dastur",
      "permanent": true
    },
    {
      "source": "/usa-lab-m10",
      "destination": "/usa-lab-dastur",
      "permanent": true
    },
    {
      "source": "/usa-lab-m10.html",
      "destination": "/usa-lab-dastur",
      "permanent": true
    },
    {
      "source": "/usa-lab-m11",
      "destination": "/usa-lab-dastur",
      "permanent": true
    },
    {
      "source": "/usa-lab-m11.html",
      "destination": "/usa-lab-dastur",
      "permanent": true
    }
  ]
}
